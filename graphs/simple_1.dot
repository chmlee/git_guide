digraph GitSnapshot {
  newrank=true;
  rankdir=TB;
  nodesep=1;
  ranksep=1;

  node [
    fontsize=15
    width=1.5
    height=1
  ]

  subgraph cluster_commits {
    label="commits";

    style="rounded";
    color="#111111";
    penwidth=2;
    margin=30;

    C1 [shape=oval, label=<commit<br/>C1>];
  }

  subgraph cluster_storage {
    label="storage";

    style="rounded";
    color="#111111";
    penwidth=2;
    margin=30;

    B1 [shape=note,
      label=<<b>todo.txt</b>&nbsp;(version 1)<br align="left"/><font face="monospace">grocery:<br align="left"/>&nbsp;&nbsp;apple<br align="left"/>&nbsp;&nbsp;banana<br align="left"/></font>>];
  }

  C1 -> B1 [style=dashed, label="snapshot"];

  { rank = same; C1; B1; }
}

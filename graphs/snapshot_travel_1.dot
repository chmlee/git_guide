digraph GitSnapshot {
  splines=false;
  newrank=true;
  rankdir=TB;
  nodesep=1.5; 
  ranksep=0.5;
  fontsize=35


  node [
    fontsize=30
    width=1
    height=1
  ]

  H [label="You", color="red", fontcolor="red"];
  H -> C1 [color="red"];

  subgraph cluster_commits {
    label="commits";
    style="rounded";
    color="#111111";
    penwidth=2;
    margin=30;

    C1 [shape=oval, label=<commit<br/>C1>, color=red, fontcolor=red];
    C2 [shape=oval, label=<commit<br/>C2>];
    C3 [shape=oval, label=<commit<br/>C3>];

    C1 -> C2 [weight=10];
    C2 -> C3 [weight=10];
  }

  subgraph cluster_storage {
    label="storage";
    style="rounded";
    color="#111111";
    penwidth=2;
    margin=30;

    node [
      fontsize=25
      shape=note
    ]

    B1 [label=<<b>report.Rmd</b><br/>(version 1)>, color=red, fontcolor=red];
    B2 [label=<<b>report.Rmd</b><br/>(version 2)>];
    B3 [label=<<b>report.Rmd</b><br/>(version 3)>];
    BD [label=<<b>data.csv</b><br/>(version 1)>, color=red, fontcolor=red];

    edge [style=invis, weight=10];
    B1 -> BD -> B2 -> B3 
  }

  // Align each commit with the TOP file of the pair
  { rank=same; H; C1; B1; }
  { rank=same; C2; B2; }
  { rank=same; C3; B3; }

  edge [style = dashed]
  C1 -> B1 [color=red];
  C2 -> B2;
  C3 -> B3;

  edge [
    constraint=false,
  ]
  C1 -> BD [color=red];
  C2 -> BD;
  C3 -> BD;
}

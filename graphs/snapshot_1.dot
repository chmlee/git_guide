digraph GitSnapshot {
  splines=false
  newrank=true;
  rankdir=TB;
  nodesep=1.5; 
  ranksep=0.5;
  fontsize=35

  node [
    fontsize=30
    width=1
    height=1
  ]

  subgraph cluster_commits {
    label="commits";
    style="rounded";
    color="#111111";
    penwidth=2;
    margin=30;

    C1 [shape=oval, label=<commit<br/>C1>];
  }

  subgraph cluster_storage {
    label="storage";
    style="rounded";
    color="#111111";
    penwidth=2;
    margin=30;

    node [
      fontsize=25
      shape=note
    ]

    B1 [label=<<b>report.Rmd</b><br/>(version 1)>];
    BD [label=<<b>data.csv</b><br/>(version 1)>];

    edge [style=invis, weight=10];
    B1 -> BD
  }

  // Align each commit with the TOP file of the pair
  { rank=same; C1; B1; }

  edge [style = dashed]
  C1 -> B1;

  edge [
    constraint=false,
  ]
  C1 -> BD;
}
